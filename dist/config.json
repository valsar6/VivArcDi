{
  "styles": [
    "styles/base.css",
    "styles/favorites.css",
    "styles/folder-preview.css",
    "styles/folders.css",
    "styles/peek.css",
    "styles/pinned.css",
    "styles/today.css",
    "styles/toast.css"
  ],
  "modules": {
    "activation-marker": {
      "enabled": true
    },
    "favorites-grid": {
      "enabled": true,
      "folder": "Favorites",
      "maxTiles": 12,
      "maxColumns": 3,
      "tileMinWidth": 64,
      "tileHeight": 44,
      "gap": 8,
      "unloadOnMiddleClick": true
    },
    "peek": {
      "enabled": true,
      "shiftClick": true,
      "pinnedCrossSite": true,
      "anyCrossSite": false,
      "widthPercent": 80,
      "heightPercent": 90
    },
    "reopen-pinned": {
      "enabled": true
    },
    "bookmark-folders": {
      "enabled": true,
      "root": "Importati da Firefox/Bookmarks Bar",
      "maxDepth": 3,
      "maxHeightPercent": 60
    },
    "folder-preview": {
      "enabled": true,
      "hoverDelayMs": 400
    },
    "pinned-tabs": {
      "enabled": true,
      "resetButton": true,
      "unloadOnClose": true
    },
    "today-archive": {
      "enabled": true,
      "archiveAfterHours": 12,
      "archiveLimit": 500
    },
    "copy-url": {
      "enabled": true,
      "toastMs": 2000
    }
  }
}
