{
  "name": "vivarcdi",
  "version": "0.4.2",
  "private": true,
  "description": "Make Vivaldi behave like Arc",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.scss\"",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "release": "tsx scripts/release/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.6",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "sass": "1.106.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
